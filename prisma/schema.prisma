generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  MOVIE
  SERIES
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String
  name           String
  role           Role             @default(USER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profiles       Profile[]
}

model Profile {
  id                String              @id @default(cuid())
  name              String
  avatarUrl         String?
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlistItems    Watchlist[]
  historyItems      ViewingHistory[]
  continueWatching  ContinueWatching[]
  createdAt         DateTime            @default(now())

  @@unique([userId, name])
}

model Genre {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  movies      MovieGenre[]
  series      SeriesGenre[]
  createdAt   DateTime    @default(now())
}

model Movie {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String
  releaseYear   Int
  maturity      String
  runtimeMin    Int
  backdropUrl   String
  posterUrl     String
  trailerUrl    String
  tags          String[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  genres        MovieGenre[]
}

model Series {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String
  releaseYear   Int
  maturity      String
  backdropUrl   String
  posterUrl     String
  trailerUrl    String
  tags          String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  seasons       Season[]
  genres        SeriesGenre[]
}

model Season {
  id          String    @id @default(cuid())
  number      Int
  title       String
  seriesId    String
  series      Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes    Episode[]

  @@unique([seriesId, number])
}

model Episode {
  id          String    @id @default(cuid())
  title       String
  synopsis    String
  number      Int
  runtimeMin  Int
  videoUrl    String
  seasonId    String
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, number])
}

model Watchlist {
  id           String      @id @default(cuid())
  profileId    String
  profile      Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contentType  ContentType
  contentId    String
  createdAt    DateTime    @default(now())

  @@unique([profileId, contentType, contentId])
}

model ViewingHistory {
  id           String      @id @default(cuid())
  profileId    String
  profile      Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contentType  ContentType
  contentId    String
  watchedAt    DateTime    @default(now())

  @@index([profileId, watchedAt])
}

model ContinueWatching {
  id           String      @id @default(cuid())
  profileId    String
  profile      Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contentType  ContentType
  contentId    String
  progressSec  Int         @default(0)
  updatedAt    DateTime    @updatedAt

  @@unique([profileId, contentType, contentId])
}

model MovieGenre {
  movieId   String
  genreId   String
  movie     Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model SeriesGenre {
  seriesId  String
  genreId   String
  series    Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
}
